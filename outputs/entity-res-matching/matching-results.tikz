    enlarge x limits=0.08,
    legend entries={GPT-5.6 Sol, Gemini 3.8 Flash, DeepSeek v4.1 Flash, Mistral Medium 3.5},
    legend to name=leg:matching_results_models,
    legend image code/.code={%
        \draw[#1, draw=none] (0cm,-0.06cm) rectangle (0.35cm,0.18cm);
    },
    legend style={
        legend columns=4,
        column sep=4.5mm,
        font=\footnotesize,
        draw=gray!35,
        fill=white,
        rounded corners=2pt
    }
]

