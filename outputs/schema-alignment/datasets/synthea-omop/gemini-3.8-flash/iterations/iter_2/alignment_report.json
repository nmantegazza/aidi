    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "synthea.patients",
            "omop.person",
            "synthea.encounters",
            "omop.visit_occurrence",
            "synthea.procedures",
            "omop.procedure_occurrence"
          ],
          "description": "Entity and attribute naming differences between Synthea patient-centric naming (e.g. 'patients.birthdate', 'encounters', 'procedures') and OMOP CDM standardized relational naming (e.g. 'person.birth_datetime', 'visit_occurrence', 'procedure_occurrence').",
          "resolution": "Harmonized domain entities onto OMOP-aligned standardized snake_case schema naming conventions, mapping Synthea entities directly into the unified resources."
        },
        {
          "source_references": [
            "synthea.organizations",
            "omop.care_site",
            "omop.location"
          ],
          "description": "Attribute naming discrepancies for organizational entities: Synthea uses 'organizations' with columns 'address', 'city', 'state', 'zip' whereas OMOP uses 'care_site' joined to 'location' and 'provider'.",
          "resolution": "Preserved unified care site/organization resource capturing core administrative and geographic attributes."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "synthea.encounters.cost",
            "synthea.procedures.cost",
            "synthea.immunizations.cost",
            "omop.cost.total_cost"
          ],
          "description": "Cost fields in Synthea (e.g. 'encounters.cost', 'procedures.cost', 'immunizations.cost') are represented as strings, whereas monetary amounts are quantitative numbers.",
          "resolution": "Standardized financial/cost fields to Frictionless generic type 'number'."
        },
        {
          "source_references": [
            "synthea.observations.value",
            "omop.observations.value_as_string",
            "omop.observations.value_as_number"
          ],
          "description": "Observation value types differ: Synthea stores 'value' as string with a numeric 'type' flag, while OMOP supports both 'value_as_number' (number) and 'value_as_string' (string).",
          "resolution": "Standardized distinct columns for string and numeric observation values."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
          "source_references": [
            "synthea.patients.address",
            "synthea.organizations.address",
            "synthea.providers.address",
            "omop.location"
          ],
          "description": "Synthea stores addresses embedded directly within entity records ('patients', 'organizations', 'providers'), while OMOP normalizes geographic addresses into a dedicated 'location' table.",
          "resolution": "Normalized address attributes into a shared location structure and preserved foreign key relationships referencing location across persons, providers, and care sites."
        },
        {
          "source_references": [
            "synthea.allergies",
            "synthea.careplans",
            "synthea.immunizations",
            "omop.observation",
            "omop.drug_exposure"
          ],
          "description": "Synthea represents allergies, care plans, and immunizations as dedicated clinical event tables, whereas OMOP standardizes these as clinical events across condition_occurrence, drug_exposure, observation, and procedure_occurrence.",
          "resolution": "Maintained explicit normalized tables for clinical domains while capturing OMOP-aligned concepts, occurrence intervals, and source mappings."
        }
      ]
    },
