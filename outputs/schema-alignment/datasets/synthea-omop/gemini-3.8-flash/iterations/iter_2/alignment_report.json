          ],
          "description": "Synthea encodes clinical conditions and procedures primarily using SNOMED-CT text codes directly, whereas OMOP relies on mapped standard concept IDs alongside source concept IDs and verbatim source values.",
          "resolution": "Modeled both standard concept identifiers and verbatim/source codes and descriptions to support dual semantic representations without information loss."
        }
      ]
    },
