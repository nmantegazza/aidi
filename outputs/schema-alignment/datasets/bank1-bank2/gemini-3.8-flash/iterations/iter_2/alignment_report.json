  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.customer.custid",
            "bank1.customer.name",
            "bank1.customer.phone",
            "bank2.customer.customer_id",
            "bank2.customer.customer_name",
            "bank2.customer.mobileno"
          ],
          "description": "Synonymous naming for customer identification, customer name, and customer contact number across bank1 and bank2 (e.g., custid vs customer_id, name vs customer_name, phone vs mobileno).",
          "resolution": "Standardized customer table columns to snake_case canonical names: customer_id, customer_name, and phone_number."
        },
        {
          "source_references": [
            "bank1.branch.name",
            "bank1.branch.address",
            "bank2.branch.branch_name",
            "bank2.branch.branch_address"
          ],
          "description": "Synonymous naming for branch attributes between bank1 and bank2 (e.g., name vs branch_name, address vs branch_address).",
          "resolution": "Standardized branch table columns to canonical names: branch_id, branch_name, and address."
        },
        {
          "source_references": [
            "bank1.account.account_no",
            "bank1.account.acc_type",
            "bank1.account.balance",
            "bank2.account.account_id",
            "bank2.account.account_type",
            "bank2.account.account_balance"
          ],
          "description": "Synonymous naming for account attributes between bank1 and bank2 (e.g., account_no vs account_id, acc_type vs account_type, balance vs account_balance).",
          "resolution": "Standardized account table attributes to account_id, account_type, and balance."
        },
        {
          "source_references": [
            "bank1.availed_by",
            "bank2.borrower"
          ],
          "description": "Synonymous naming between bank1 availed_by association and bank2 borrower table.",
          "resolution": "Adopted loan_customer (or loan_borrower) associative table naming to consistently capture customer-loan relationships."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank1.loan.amount",
            "bank2.account.account_balance",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount",
            "bank2.loan_payment.amount",
            "bank2.transaction.amount"
          ],
          "description": "Data type representation difference for monetary values: bank1 uses floating number for balances/amounts whereas bank2 uses integer.",
          "resolution": "Unified monetary fields (account balance, loan amounts, transaction amounts) under the number type to support decimal precision."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
          "source_references": [
            "bank1.bank",
            "bank1.branch.bank_code"
          ],
          "description": "bank1 models bank institution in an explicit parent entity 'bank' with 'branch' referencing 'bank', whereas bank2 lacks a dedicated bank entity.",
          "resolution": "Preserved the normalized 'bank' entity and made bank_code optional on branch to accommodate bank2 branches where bank parent is undefined."
        },
        {
          "source_references": [
            "bank1.hold_by",
            "bank1.availed_by",
            "bank2.customer.account_id",
            "bank2.borrower"
          ],
          "description": "bank1 models many-to-many relationships using dedicated bridge tables (offer, maintain, availed_by, hold_by) alongside direct foreign keys, while bank2 uses direct foreign keys and separate relationship tables (borrower). Specifically, customer-account is M:N in bank1 (hold_by) but 1:N / directly referenced in bank2.",
          "resolution": "Preserved the M:N associative bridge table customer_account (merging hold_by and bank2 customer-account association) and loan_customer (merging availed_by and borrower), while maintaining foreign keys to branches on loan and account."
        },
        {
          "source_references": [
            "bank2.banker_info",
            "bank2.transaction",
            "bank2.customer_credit_card",
            "bank2.loan_payment"
          ],
          "description": "bank2 includes specialized operational entities (banker_info, transaction, customer_credit_card, loan_payment) not present in bank1.",
          "resolution": "Retained banker_info, transaction, customer_credit_card, and loan_payment as first-class resources in the global schema to preserve operational granularity."
        }
      ]
    },
    {
      "conflict_type": "Cardinality",
      "conflicts": [
        {
          "source_references": [
            "bank1.hold_by",
            "bank2.customer.account_id"
          ],
          "description": "Customer to Account relationship cardinality mismatch: bank1 allows an M:N relationship via hold_by, whereas bank2 establishes a direct 1:N or 1:1 foreign key customer.account_id.",
          "resolution": "Resolved in favor of the more general M:N relationship using the customer_account association table, removing the restrictive single account_id foreign key from customer."
        }
      ]
    },
    {
      "conflict_type": "Key",
      "conflicts": [
        {
          "source_references": [
            "bank1.availed_by",
            "bank2.borrower.borrower_id"
          ],
          "description": "bank1 availed_by uses a composite primary key (Custid, Loan_id) whereas bank2 borrower uses a surrogate primary key borrower_id.",
          "resolution": "Used the natural composite primary key [customer_id, loan_id] for the unified customer_loan table to ensure uniqueness without redundant surrogate keys."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "Loan amount semantics: bank1 specifies a single loan amount, whereas bank2 distinguishes between issued_amount and remaining_amount.",
          "resolution": "Mapped bank1.loan.amount to amount (total/issued amount) and maintained remaining_amount as a distinct optional attribute for current debt tracking."
        }
      ]
    }
  ]
}