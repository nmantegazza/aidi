  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.branch.name",
            "bank1.branch.address",
            "bank2.branch.branch_name",
            "bank2.branch.branch_address",
            "bank1.customer.custid",
            "bank1.customer.name",
            "bank1.customer.phone",
            "bank2.customer.customer_id",
            "bank2.customer.customer_name",
            "bank2.customer.mobileno",
            "bank1.account.account_no",
            "bank1.account.acc_type",
            "bank1.account.balance",
            "bank2.account.account_id",
            "bank2.account.account_type",
            "bank2.account.account_balance",
            "bank1.availed_by",
            "bank2.borrower"
          ],
          "description": "Differences in attribute and entity naming across schemas: bank2 uses branch_name/branch_address while bank1 uses name/address; bank1 uses custid/name/phone while bank2 uses customer_id/customer_name/mobileno; bank1 uses account_no/acc_type/balance while bank2 uses account_id/account_type/account_balance; bridge tables availed_by in bank1 corresponds to borrower in bank2; hold_by in bank1 corresponds to customer-account relationship.",
          "resolution": "Adopted normalized, standardized snake_case naming conventions (e.g., customer, account, branch, loan, loan_customer, customer_account)."
        },
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "Loan amount representation: bank1 defines a single 'amount' while bank2 distinguishes 'issued_amount' and 'remaining_amount'.",
          "resolution": "Retained 'amount' / 'issued_amount' as total issued amount and included 'remaining_amount' as an optional field in loan."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance",
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "Account balance and loan amount are defined as 'number' (floating-point) in bank1 but 'integer' in bank2.",
          "resolution": "Standardized financial amounts and balances to 'number' in the target schema to accommodate fractional currency units without loss of precision."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.bank",
            "bank1.branch.bank_code"
          ],
          "description": "bank1 contains bank institutional information (bank table with code, name, address) whereas bank2 models branches directly without a parent bank entity.",
          "resolution": "Maintained bank as a parent resource with bank_code foreign keys on branch where applicable."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
          "source_references": [
            "bank2.banker_info",
            "bank2.customer_credit_card",
            "bank2.loan_payment"
          ],
          "description": "bank2 contains entities not present in bank1: banker_info, customer_credit_card, and loan_payment.",
          "resolution": "Included banker_info, credit_card, and loan_payment as distinct first-class resources in the target schema."
        },
        {
          "source_references": [
            "bank1.offer",
            "bank1.maintain",
            "bank1.loan.branch_id",
            "bank1.account.branch_id",
            "bank2.loan.branch_id",
            "bank2.account.branch_id"
          ],
          "description": "Redundant relationship tables in bank1: bank1 defines 'offer' (branch-loan) and 'maintain' (branch-account) while both loan and account already possess direct foreign keys to branch.",
          "resolution": "Omitted redundant relationship tables offer and maintain in favor of direct branch_id foreign keys present on account and loan in both schemas."
        }
      ]
    },
    {
      "conflict_type": "Cardinality",
      "conflicts": [
        {
          "source_references": [
            "bank1.hold_by",
            "bank2.customer.account_id"
          ],
          "description": "Customer-to-account relationship: bank1 supports an N:M relationship via bridge table 'hold_by', whereas bank2 models customer with a single foreign key 'account_id' (implying N:1 or 1:1) and credit cards/transactions also linking customer and account.",
          "resolution": "Standardized customer-to-account relationships into an N:M junction table 'customer_account' (incorporating bank1.hold_by and bank2's customer-account relationship) to accommodate multi-account ownership and joint accounts."
        },
        {
          "source_references": [
            "bank1.availed_by",
            "bank2.borrower"
          ],
          "description": "Customer-to-loan relationship: bank1 models N:M via availed_by (composite PK [custid, loan_id]) while bank2 models N:M via borrower with a surrogate PK borrower_id.",
          "resolution": "Unified loan borrower / availed_by relationship into a single associative entity 'loan_borrower' with composite key [customer_id, loan_id]."
        }
      ]
    },
    {
      "conflict_type": "Key",
      "conflicts": [
        {
          "source_references": [
            "bank1.availed_by.custid",
            "bank1.availed_by.loan_id",
            "bank2.borrower.borrower_id",
            "bank2.borrower.customer_id",
            "bank2.borrower.loan_id"
          ],
          "description": "bank2.borrower uses a surrogate primary key (borrower_id) whereas bank1.availed_by uses a composite primary key (custid, loan_id).",
          "resolution": "Defined composite primary key [customer_id, loan_id] for the unified loan_borrower bridge table; mapped source identifiers accordingly."
        }
      ]
    }
  ]
}