  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.branch.name",
            "bank2.branch.branch_name",
            "bank1.branch.address",
            "bank2.branch.branch_address",
            "bank1.customer.custid",
            "bank2.customer.customer_id",
            "bank1.customer.name",
            "bank2.customer.customer_name",
            "bank1.customer.phone",
            "bank2.customer.mobileno",
            "bank1.account.account_no",
            "bank2.account.account_id",
            "bank1.account.acc_type",
            "bank2.account.account_type"
          ],
          "description": "Entity and attribute name variations across bank1 and bank2: branch name ('name' vs 'branch_name'), address ('address' vs 'branch_address'), customer identifiers ('custid' vs 'customer_id'), customer names ('name' vs 'customer_name'), phone numbers ('phone' vs 'mobileno'), account identifiers ('account_no' vs 'account_id'), and account types ('acc_type' vs 'account_type').",
          "resolution": "Standardized table and attribute names using descriptive snake_case naming conventions (e.g., branch_name, customer_id, account_id, account_type, phone_number)."
        },
        {
          "source_references": [
            "bank1.availed_by",
            "bank2.borrower"
          ],
          "description": "Customer-loan association table naming: bank1 names the association 'availed_by' while bank2 names it 'borrower'.",
          "resolution": "Consolidated into the standard associative entity 'loan_borrower' (or 'borrower')."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance",
            "bank1.loan.amount",
            "bank2.loan.issued_amount"
          ],
          "description": "Monetary amount and balance attributes use number (float/decimal) in bank1 but integer in bank2 (e.g., account balance, loan amount).",
          "resolution": "Standardized all monetary amounts and balance fields to generic type 'number' to accommodate fractional currency units without loss of precision."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "In bank1, 'loan.amount' represents the total principal loan amount, whereas in bank2, loans explicitly distinguish between 'issued_amount' and 'remaining_amount'.",
          "resolution": "Mapped bank1.loan.amount and bank2.loan.issued_amount to target field 'amount' (principal/issued amount), and retained 'remaining_amount' as an optional field for schemas providing balance tracking."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
          "source_references": [
            "bank1.bank",
            "bank1.branch.bank_code"
          ],
          "description": "bank1 models an enterprise hierarchy starting with a 'bank' entity with multiple branches, whereas bank2 only models standalone branches without a parent bank entity.",
          "resolution": "Retained 'bank' as an independent parent resource, making the 'bank_code' reference in 'branch' optional so branches without a parent bank (such as in bank2) can be accommodated."
        },
        {
          "source_references": [
            "bank2.banker_info",
            "bank2.customer_credit_card",
            "bank2.loan_payment",
            "bank1.offer",
            "bank1.maintain"
          ],
          "description": "bank2 includes domain-specific entities not present in bank1: banker information ('banker_info'), customer credit cards ('customer_credit_card'), and loan payment history ('loan_payment'). Additionally, bank1 contains explicit M:N or redundant bridge tables ('offer', 'maintain') which duplicate direct foreign key relationships.",
          "resolution": "Preserved banker_info, customer_credit_card, and loan_payment in the target schema. Retained direct foreign keys for account-branch and loan-branch relationships, while deprecating redundant binary relationship tables where direct FKs suffice."
        }
      ]
    },
    {
      "conflict_type": "Cardinality",
      "conflicts": [
        {
          "source_references": [
            "bank1.hold_by",
            "bank2.customer.account_id"
          ],
          "description": "Customer-to-account relationship: bank1 models a many-to-many relationship via 'hold_by', whereas bank2 embeds a single 'account_id' foreign key directly inside the 'customer' table (1:N or N:1 constraint).",
          "resolution": "Adopted a normalized bridge resource 'customer_account' (derived from bank1.hold_by and bank2's customer-account relationship) to support many-to-many account ownership without loss of generality."
        }
      ]
    },
    {
      "conflict_type": "Key",
      "conflicts": [
        {
          "source_references": [
            "bank1.availed_by",
            "bank2.borrower.borrower_id"
          ],
          "description": "Bridge table primary keys: bank1.availed_by uses composite key (custid, loan_id), whereas bank2.borrower defines a surrogate primary key (borrower_id).",
          "resolution": "Used composite primary key (customer_id, loan_id) for the associative table 'loan_borrower' to ensure relational uniqueness across customer-loan pairs."
        }
      ]
    }
  ]
}