  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.customer.custid",
            "bank2.customer.customer_id"
          ],
          "description": "The customer primary-key attribute is named 'custid' in bank1 and 'customer_id' in bank2, referring to the same entity identity.",
          "resolution": "Unified into single attribute 'customer_id' in the target customer resource, with both source columns recorded as provenance."
        },
        {
          "source_references": [
            "bank1.customer.name",
            "bank2.customer.customer_name"
          ],
          "description": "Customer name column uses the generic name 'name' in bank1 and 'customer_name' in bank2.",
          "resolution": "Standardized to 'customer_name' to avoid ambiguity with other name columns."
        },
        {
          "source_references": [
            "bank1.customer.phone",
            "bank2.customer.mobileno"
          ],
          "description": "The customer telephone attribute is 'phone' in bank1 and 'mobileno' in bank2.",
          "resolution": "Standardized to 'phone' as the canonical customer contact field."
        },
        {
          "source_references": [
            "bank1.branch.name",
            "bank2.branch.branch_name"
          ],
          "description": "Branch name is 'name' in bank1 and 'branch_name' in bank2.",
          "resolution": "Standardized to 'branch_name'."
        },
        {
          "source_references": [
            "bank1.branch.address",
            "bank2.branch.branch_address"
          ],
          "description": "Branch address is 'address' in bank1 and 'branch_address' in bank2.",
          "resolution": "Standardized to 'address' within the branch resource."
        },
        {
          "source_references": [
            "bank1.account.account_no",
            "bank2.account.account_id"
          ],
          "description": "Account primary key is 'account_no' in bank1 and 'account_id' in bank2.",
          "resolution": "Standardized to 'account_id'."
        },
        {
          "source_references": [
            "bank1.account.acc_type",
            "bank2.account.account_type"
          ],
          "description": "Account category attribute is abbreviated 'acc_type' in bank1 and 'account_type' in bank2.",
          "resolution": "Standardized to 'account_type'."
        },
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Account balance is 'balance' in bank1 and 'account_balance' in bank2.",
          "resolution": "Standardized to 'balance' within the account resource."
        },
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount"
          ],
          "description": "The loan principal is named generically 'amount' in bank1 and 'issued_amount' in bank2.",
          "resolution": "Standardized to 'issued_amount' to disambiguate from other amount columns (transaction.amount, loan_payment.amount)."
        },
        {
          "source_references": [
            "bank1.branch.foreignKeys[].fields='Bank_Code'",
            "bank1.loan.foreignKeys[].fields='Branch_id'",
            "bank1.offer.primaryKey=['Branch_id','Loan_id']",
            "bank1.maintain.primaryKey=['Branch_id','Account_No']",
            "bank1.availed_by.primaryKey=['Custid','Loan_id']",
            "bank1.hold_by.primaryKey=['Custid','Account_No']"
          ],
          "description": "bank1 contains inconsistent casing/homonyms for the same conceptual columns (e.g. 'branch_id' vs 'Branch_id', 'account_no' vs 'Account_No', 'loan_id' vs 'Loan_id', 'custid' vs 'Custid', 'bank_code' vs 'Bank_Code'). Several FK entries reference capitalized field names that do not exist as declared columns.",
          "resolution": "Normalized all identifiers to lower snake_case, collapsing each casing variant to a single canonical column and dropping the dangling capitalized FK references."
        },
        {
          "source_references": [
            "bank1.bank",
            "bank2.branch"
          ],
          "description": "bank1 models an explicit 'bank' entity while bank2 has no bank concept; branch-level attributes overlap the naming of bank-level attributes.",
          "resolution": "Retained a distinct 'bank' resource (bank1 only) and kept 'branch' as the shared branch resource, avoiding name collision."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance",
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount",
            "bank2.branch.assets",
            "bank2.transaction.amount",
            "bank2.loan_payment.amount",
            "bank2.customer_credit_card.card_limit"
          ],
          "description": "Monetary values are typed as 'number' in bank1 (account.balance, loan.amount) but as 'integer' in bank2 (account_balance, issued_amount, remaining_amount, assets, transaction.amount, loan_payment.amount, card_limit).",
          "resolution": "Unified all monetary columns to the generic 'number' type to accommodate fractional currency amounts without loss of precision."
        },
        {
          "source_references": [
            "bank1.account.account_no",
            "bank2.account.account_id",
            "bank1.customer.custid",
            "bank2.customer.customer_id"
          ],
          "description": "Identifier columns are consistently integer in both schemas; no numeric/string mismatch, but bank1.bank.code (string) vs branch-level code semantics differ.",
          "resolution": "Kept all surrogate entity identifiers as integer; retained bank_code as string since it is a business code, not a numeric surrogate."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
