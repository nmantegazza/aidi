  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.customer.custid",
            "bank2.customer.customer_id"
          ],
          "description": "Same customer identity attribute is named 'custid' in bank1 and 'customer_id' in bank2 (synonym divergence, and also the target PK of the merged customer entity).",
          "resolution": "Unified to snake_case 'customer_id' as the target primary key of the customer resource."
        },
        {
          "source_references": [
            "bank1.customer.name",
            "bank2.customer.customer_name"
          ],
          "description": "Customer name column is 'name' (bank1) vs 'customer_name' (bank2).",
          "resolution": "Unified to 'name'."
        },
        {
          "source_references": [
            "bank1.customer.phone",
            "bank2.customer.mobileno"
          ],
          "description": "Customer telephone column named 'phone' (bank1) vs 'mobileno' (bank2).",
          "resolution": "Unified to 'phone'; both represent the customer contact number."
        },
        {
          "source_references": [
            "bank1.account.account_no",
            "bank2.account.account_id"
          ],
          "description": "Account identifier named 'account_no' (bank1) vs 'account_id' (bank2).",
          "resolution": "Unified to 'account_id' as the merged account primary key."
        },
        {
          "source_references": [
            "bank1.account.acc_type",
            "bank2.account.account_type"
          ],
          "description": "Account type attribute named 'acc_type' (bank1) vs 'account_type' (bank2).",
          "resolution": "Unified to 'account_type'."
        },
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Account balance column named 'balance' (bank1) vs 'account_balance' (bank2).",
          "resolution": "Unified to 'balance'."
        },
        {
          "source_references": [
            "bank1.branch.name",
            "bank2.branch.branch_name"
          ],
          "description": "Branch name column named 'name' (bank1) vs 'branch_name' (bank2).",
          "resolution": "Unified to 'name' inside the merged branch resource."
        },
        {
          "source_references": [
            "bank1.branch.address",
            "bank2.branch.branch_address"
          ],
          "description": "Branch address column named 'address' (bank1) vs 'branch_address' (bank2).",
          "resolution": "Unified to 'address' inside the merged branch resource."
        },
        {
          "source_references": [
            "bank1.bank.code",
            "bank1.branch.bank_code"
          ],
          "description": "The bank identifier 'code' is a bare homonym for the parent bank key.",
          "resolution": "Renamed to 'bank_code' to make the entity key explicit and consistent with the referencing column."
        },
        {
          "source_references": [
            "bank2.banker_info.banker_name",
            "bank2.banker_info"
          ],
          "description": "Resource 'banker_info' and its 'banker_name' column diverge in naming style from the rest of the model.",
          "resolution": "Resource renamed to 'banker' and 'banker_name' normalized to 'name'."
        },
        {
          "source_references": [
            "bank1.offer",
            "bank1.maintain",
            "bank1.availed_by",
            "bank1.hold_by"
          ],
          "description": "bank1 uses verb-like association table names for its cross-entity links (offer, maintain, availed_by, hold_by).",
          "resolution": "Retained meaningful association names offer/maintain for the branch links; renamed the merged person-loan and person-account links to the canonical 'customer_loan' and 'customer_account'."
        },
        {
          "source_references": [
            "bank1.branch.Bank_Code",
            "bank1.branch.Code",
            "bank1.loan.Branch_id",
            "bank1.account.Branch_id",
            "bank1.offer.Branch_id",
            "bank1.maintain.Branch_id",
            "bank1.availed_by.Custid",
            "bank1.hold_by.Custid"
          ],
          "description": "bank1 declares a second, PascalCase variant of each foreign key (Bank_Code, Branch_id, Custid, ...) that is a case-only homonym of the real column and points at non-existent PascalCase PKs.",
          "resolution": "Treated as naming artifacts of the canonical lowercase columns and dropped; only one canonical FK per relationship is retained."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Merged account balance is typed 'number' in bank1 but 'integer' in bank2.",
          "resolution": "Widened to 'number' (the superset) so both sources load without precision loss."
        },
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "Loan monetary columns are 'number' in bank1 but 'integer' in bank2.",
          "resolution": "Standardized loan monetary columns to 'number' for cross-source homogeneity."
        },
        {
          "source_references": [
            "bank2.transaction.amount",
            "bank2.loan_payment.amount",
            "bank2.customer_credit_card.card_limit"
          ],
          "description": "Monetary columns declared as 'integer' in bank2 are inconsistent with the 'number' money representation chosen globally.",
          "resolution": "Normalized to 'number' so all monetary attributes share one representation; 'assets' stays integer as a count."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "bank1 models a loan's value as a single 'amount', whereas bank2 decomposes it into the issued principal and the outstanding balance — related but not identical concepts.",
          "resolution": "Kept as three distinct, semantically homogeneous attributes (amount, issued_amount, remaining_amount); 'amount' was NOT collapsed into 'issued_amount' because the exact same semantic attribute cannot be guaranteed."
        },
        {
          "source_references": [
            "bank1.branch.assets",
            "bank2.branch.assets"
          ],
          "description": "bank2 adds a 'branch.assets' quantitative attribute with no bank1 counterpart, and it is a monetary magnitude rather than an identifier.",
          "resolution": "Retained as its own integer attribute on the merged branch resource; no other source column was mapped to it."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
