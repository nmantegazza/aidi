  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.customer.custid",
            "bank2.customer.customer_id"
          ],
          "description": "Customer primary key is named 'custid' in bank1 but 'customer_id' in bank2.",
          "resolution": "Unified to 'customer_id' following the bank2 snake_case convention; both identifiers are grouped in the same column provenance."
        },
        {
          "source_references": [
            "bank1.customer.name",
            "bank2.customer.customer_name"
          ],
          "description": "Customer name attribute named 'name' (bank1) vs 'customer_name' (bank2).",
          "resolution": "Unified to 'name' as the atomic attribute name for the customer resource."
        },
        {
          "source_references": [
            "bank1.customer.phone",
            "bank2.customer.mobileno"
          ],
          "description": "Contact number stored as 'phone' (bank1) vs 'mobileno' (bank2).",
          "resolution": "Unified to 'phone' as the canonical mobile/telephone attribute."
        },
        {
          "source_references": [
            "bank1.branch.name",
            "bank2.branch.branch_name"
          ],
          "description": "Branch label named 'name' (bank1) vs 'branch_name' (bank2).",
          "resolution": "Unified to 'name' within the branch resource."
        },
        {
          "source_references": [
            "bank1.branch.address",
            "bank2.branch.branch_address"
          ],
          "description": "Branch address named 'address' (bank1) vs 'branch_address' (bank2).",
          "resolution": "Unified to 'address' within the branch resource."
        },
        {
          "source_references": [
            "bank1.account.acc_type",
            "bank2.account.account_type"
          ],
          "description": "Account type attribute abbreviated as 'acc_type' (bank1) vs 'account_type' (bank2).",
          "resolution": "Unified to 'account_type' using the fully spelled snake_case name."
        },
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Account balance named 'balance' (bank1) vs 'account_balance' (bank2).",
          "resolution": "Unified to 'balance' within the account resource."
        },
        {
          "source_references": [
            "bank1.account.account_no",
            "bank2.account.account_id"
          ],
          "description": "Account identifier named 'account_no' (bank1) vs 'account_id' (bank2).",
          "resolution": "Unified to 'account_id' as the account primary key column name."
        },
        {
          "source_references": [
            "bank2.banker_info",
            "bank2.banker_info.banker_name"
          ],
          "description": "Resource 'banker_info' and column 'banker_name' carry redundant entity prefixes relative to the target naming scheme.",
          "resolution": "Resource renamed to 'banker' and column to 'name' for a normalized, consistent naming convention."
        },
        {
          "source_references": [
            "bank1.hold_by",
            "bank1.availed_by",
            "bank1.maintain",
            "bank1.offer",
            "bank2.borrower"
          ],
          "description": "Relationship resources use heterogeneous, verb-based names (hold_by, availed_by, maintain, offer) in bank1 while bank2 names the analogous bridge 'borrower' as if it were an entity.",
          "resolution": "Bridge resources renamed to a consistent composite <entity>_<entity> convention (customer_account, customer_loan, branch_account, branch_loan)."
        },
        {
          "source_references": [
            "bank2.customer_credit_card"
          ],
          "description": "Resource named 'customer_credit_card' embeds the parent entity name prefix.",
          "resolution": "Renamed to 'credit_card'; the customer linkage is captured through the customer_id foreign key."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Account balance is declared 'number' in bank1 but 'integer' in bank2.",
          "resolution": "Promoted to 'number' to preserve fractional monetary precision without loss across both sources."
        },
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount"
          ],
          "description": "Loan principal is 'number' in bank1 but 'integer' in bank2.",
          "resolution": "Promoted to 'number' so the unified 'issued_amount' column accommodates both representations."
        },
        {
          "source_references": [
            "bank2.transaction.amount",
            "bank2.loan_payment.amount",
            "bank2.customer_credit_card.card_limit",
            "bank2.branch.assets"
          ],
          "description": "All bank2 monetary/quantitative attributes (transaction amount, loan payment amount, card limit, branch assets) are declared 'integer', whereas bank1 monetary attributes use 'number'.",
          "resolution": "Monetary measures normalized to 'number'; 'assets' retained as 'integer' since it is a count-like magnitude only present in bank2."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount"
          ],
          "description": "Both columns denote the loan principal, but bank1 labels it generically as 'amount' while bank2 distinguishes 'issued_amount' from 'remaining_amount'.",
          "resolution": "Merged into 'issued_amount' as the single principal-amount attribute; the assumption that bank1 'amount' equals the issued principal is documented, and 'remaining_amount' is kept as a distinct attribute."
        },
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance",
            "bank2.transaction.amount",
            "bank2.loan_payment.amount"
          ],
          "description": "Monetary scale representation differs: bank2 models money as whole-number integers while bank1 permits decimal numbers, implying different implicit precision/scale (e.g., whole currency units vs. fractional).",
          "resolution": "All monetary quantities unified to the 'number' type so a single decimal currency unit convention applies across the global schema."
        },
        {
          "source_references": [
            "bank1.account.acc_type",
            "bank2.account.account_type"
          ],
          "description": "Categorical account-type values may follow different domain encodings between the two sources.",
          "resolution": "Both mapped to a single 'account_type' string attribute; value-level harmonization is deferred to the transformation layer."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
          "source_references": [
            "bank1.hold_by",
            "bank2.customer.account_id"
