  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.branch.name",
            "bank2.branch.branch_name"
          ],
          "description": "Synonym conflict: Different column names for the same semantic attribute (branch name). bank1 uses 'name' while bank2 uses 'branch_name'.",
          "resolution": "Standardized to 'name' in the unified branch table to maintain semantic consistency."
        },
        {
          "source_references": [
            "bank1.branch.address",
            "bank2.branch.branch_address"
          ],
          "description": "Synonym conflict: Different column names for branch address attribute.",
          "resolution": "Standardized to 'address' in the unified branch table."
        },
        {
          "source_references": [
            "bank1.account.acc_type",
            "bank2.account.account_type"
          ],
          "description": "Synonym conflict: Different column names for account type attribute.",
          "resolution": "Standardized to 'account_type' in the unified account table."
        },
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Synonym conflict: Different column names for account balance attribute.",
          "resolution": "Standardized to 'balance' in the unified account table."
        },
        {
          "source_references": [
            "bank1.customer.custid",
            "bank2.customer.customer_id"
          ],
          "description": "Synonym conflict: Different primary key names for customer entity.",
          "resolution": "Standardized to 'customer_id' as the primary key in the unified customer table."
        },
        {
          "source_references": [
            "bank1.customer.name",
            "bank2.customer.customer_name"
          ],
          "description": "Synonym conflict: Different column names for customer name attribute.",
          "resolution": "Standardized to 'name' in the unified customer table."
        },
        {
          "source_references": [
            "bank1.customer.phone",
            "bank2.customer.mobileno"
          ],
          "description": "Synonym conflict: Different column names for customer phone attribute.",
          "resolution": "Standardized to 'phone' in the unified customer table."
        },
        {
          "source_references": [
            "bank1.account.account_no",
            "bank2.account.account_id"
          ],
          "description": "Synonym conflict: Different primary key names for account entity.",
          "resolution": "Standardized to 'account_id' as the primary key in the unified account table."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Type mismatch: bank1 uses 'number' (floating-point) for balance while bank2 uses 'integer'.",
          "resolution": "Used 'number' type in the unified schema to accommodate both integer and decimal balance values."
        },
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount"
          ],
          "description": "Type mismatch: bank1 uses 'number' for loan amount while bank2 uses 'integer' for issued_amount.",
          "resolution": "Used 'number' type for all monetary amount fields in the unified schema to maintain precision."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "Semantic difference: bank1 has a single 'amount' field representing total loan amount, while bank2 separates into 'issued_amount' and 'remaining_amount'.",
          "resolution": "Preserved all three fields in the unified loan table to maintain semantic distinctions from both sources."
        },
        {
          "source_references": [
            "bank1.bank",
            "bank2.branch"
          ],
          "description": "Semantic difference: bank1 explicitly models 'bank' as a separate entity with branches, while bank2 has no bank entity.",
          "resolution": "Included 'bank' entity in the unified schema with 'branch.bank_code' as nullable FK to accommodate both structures."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
          "source_references": [
            "bank1.offer",
            "bank1.maintain",
            "bank1.availed_by",
            "bank1.hold_by",
            "bank2.borrower",
            "bank2.customer.account_id"
          ],
          "description": "Structure conflict: bank1 uses explicit junction tables for all relationships, while bank2 uses foreign keys in entity tables or separate relationship tables.",
          "resolution": "Normalized to consistent structure using explicit junction tables (customer_account, customer_loan) for many-to-many relationships."
        },
        {
          "source_references": [
            "bank2.transaction"
          ],
          "description": "Structure conflict: bank2 includes a 'transaction' entity that has no counterpart in bank1.",
          "resolution": "Included 'transaction' table in the unified schema to preserve bank2's data."
        },
        {
          "source_references": [
            "bank2.customer_credit_card"
          ],
          "description": "Structure conflict: bank2 includes credit card information that has no counterpart in bank1.",
          "resolution": "Included 'credit_card' table in the unified schema to preserve bank2's data."
        },
        {
          "source_references": [
            "bank2.banker_info"
          ],
          "description": "Structure conflict: bank2 includes banker information that has no counterpart in bank1.",
          "resolution": "Included 'banker' table in the unified schema to preserve bank2's data."
        }
      ]
    },
    {
      "conflict_type": "Cardinality",
      "conflicts": [
        {
          "source_references": [
            "bank1.hold_by",
            "bank2.customer.account_id"
          ],
          "description": "Cardinality mismatch: bank1 models customer-account as many-to-many via 'hold_by', while bank2 models it as one-to-many via 'account_id' in customer.",
          "resolution": "Normalized to many-to-many with explicit 'customer_account' junction table to accommodate both sources."
        }
      ]
    },
    {
      "conflict_type": "Key",
      "conflicts": [
        {
          "source_references": [
            "bank1.branch.bank_code",
            "bank2.branch"
          ],
          "description": "Key relationship difference: bank1 has 'bank_code' FK in branch to bank, while bank2 has no bank entity.",
          "resolution": "Included 'bank' entity and made 'branch.bank_code' nullable FK in unified schema."
        },
        {
          "source_references": [
            "bank1.loan",
            "bank2.loan.account_id"
          ],
          "description": "Key relationship difference: bank1 loans have no account relationship, while bank2 loans have 'account_id' FK.",
          "resolution": "Added 'account_id' as nullable FK in unified loan table to preserve bank2's relationship."
        }
      ]
    }
  ]
}