  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "bank1.branch.name",
            "bank2.branch.branch_name"
          ],
          "description": "Branch name field has different names across sources (name vs branch_name).",
          "resolution": "Standardized to 'name' in target branch table."
        },
        {
          "source_references": [
            "bank1.branch.address",
            "bank2.branch.branch_address"
          ],
          "description": "Branch address field has different names across sources (address vs branch_address).",
          "resolution": "Standardized to 'address' in target branch table."
        },
        {
          "source_references": [
            "bank1.customer.name",
            "bank2.customer.customer_name"
          ],
          "description": "Customer name field has different names across sources (name vs customer_name).",
          "resolution": "Standardized to 'name' in target customer table."
        },
        {
          "source_references": [
            "bank1.customer.phone",
            "bank2.customer.mobileno"
          ],
          "description": "Customer phone field has different names across sources (phone vs mobileno).",
          "resolution": "Standardized to 'phone' in target customer table, recognizing mobileno as a phone type."
        },
        {
          "source_references": [
            "bank1.account.acc_type",
            "bank2.account.account_type"
          ],
          "description": "Account type field has different names across sources (acc_type vs account_type).",
          "resolution": "Standardized to 'type' in target account table."
        },
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Account balance field has different names across sources (balance vs account_balance).",
          "resolution": "Standardized to 'balance' in target account table."
        },
        {
          "source_references": [
            "bank1.bank"
          ],
          "description": "Bank entity exists only in bank1 schema.",
          "resolution": "Included 'bank' table in target schema to preserve bank1's bank entity."
        },
        {
          "source_references": [
            "bank2.banker_info"
          ],
          "description": "Banker entity exists only in bank2 schema (as banker_info).",
          "resolution": "Included as 'banker' table in target schema."
        },
        {
          "source_references": [
            "bank2.transaction"
          ],
          "description": "Transaction entity exists only in bank2 schema.",
          "resolution": "Included 'transaction' table in target schema."
        },
        {
          "source_references": [
            "bank2.customer_credit_card"
          ],
          "description": "Credit card entity exists only in bank2 schema.",
          "resolution": "Included as 'credit_card' table in target schema."
        },
        {
          "source_references": [
            "bank2.loan_payment"
          ],
          "description": "Loan payment entity exists only in bank2 schema.",
          "resolution": "Included 'loan_payment' table in target schema."
        },
        {
          "source_references": [
            "bank1.offer",
            "bank1.maintain",
            "bank1.availed_by",
            "bank1.hold_by",
            "bank2.borrower"
          ],
          "description": "Junction tables have inconsistent naming across sources (offer/maintain/availed_by/hold_by vs borrower).",
          "resolution": "Standardized to descriptive junction table names (branch_loan, branch_account, customer_loan, customer_account) in target."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "bank1.account.balance",
            "bank2.account.account_balance"
          ],
          "description": "Account balance is number in bank1 but integer in bank2.",
          "resolution": "Used 'number' type in target to accommodate both representations."
        },
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "Loan amount is number in bank1 but integer in bank2 for issued/remaining amounts.",
          "resolution": "Used 'number' type for all loan amount fields in target."
        },
        {
          "source_references": [
            "bank2.transaction.amount"
          ],
          "description": "Transaction amount is integer in bank2.",
          "resolution": "Converted to 'number' type in target for consistency."
        },
        {
          "source_references": [
            "bank2.customer_credit_card.card_limit"
          ],
          "description": "Credit card limit is integer in bank2.",
          "resolution": "Converted to 'number' type in target for consistency."
        },
        {
          "source_references": [
            "bank2.loan_payment.amount"
          ],
          "description": "Loan payment amount is integer in bank2.",
          "resolution": "Converted to 'number' type in target for consistency."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "bank1.loan.amount",
            "bank2.loan.issued_amount",
            "bank2.loan.remaining_amount"
          ],
          "description": "bank1 has a single 'amount' for loan while bank2 splits into 'issued_amount' and 'remaining_amount'.",
          "resolution": "Included all three fields in target loan table (total_amount from bank1.amount, plus issued/remaining from bank2)."
        },
        {
          "source_references": [
            "bank2.branch.assets"
          ],
          "description": "bank2 includes 'assets' for branches which is absent in bank1.",
          "resolution": "Included 'assets' field in target branch table."
        },
        {
          "source_references": [
            "bank2.customer.dob"
          ],
          "description": "bank2 includes date of birth for customers which is absent in bank1.",
          "resolution": "Included 'date_of_birth' field in target customer table."
        },
