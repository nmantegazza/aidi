  "conflict_report": [
    {
      "conflict_type": "Naming",
      "conflicts": [
        {
          "source_references": [
            "imdb.name_basics.nconst",
            "sakila.actor.actor_id",
            "sakila.staff.staff_id",
            "sakila.customer.customer_id"
          ],
          "description": "Person identifiers use different naming conventions: IMDb uses 'nconst' (alphanumeric natural key) while Sakila uses separate surrogate keys ('actor_id', 'staff_id', 'customer_id').",
          "resolution": "Unified under 'person_id' in 'person' table using string type. 'person_type' field preserves source context."
        },
        {
          "source_references": [
            "imdb.title_basics.tconst",
            "sakila.film.film_id"
          ],
          "description": "Work identifiers: IMDb 'tconst' vs Sakila 'film_id'.",
          "resolution": "Unified as 'work_id' in 'work' table with string type."
        },
        {
          "source_references": [
            "imdb.title_basics.primarytitle",
            "sakila.film.title"
          ],
          "description": "Primary title field: IMDb 'primarytitle' (mis-typed as integer) vs Sakila 'title'.",
          "resolution": "Standardized as 'title' in 'work' with string type, correcting IMDb's type error."
        },
        {
          "source_references": [
            "imdb.title_basics.startyear",
            "sakila.film.release_year"
          ],
          "description": "Release year synonyms: 'startyear' vs 'release_year'.",
          "resolution": "Mapped to 'release_year' in 'work' with integer type."
        },
        {
          "source_references": [
            "imdb.title_basics.runtimeminutes",
            "sakila.film.length"
          ],
          "description": "Runtime field: 'runtimeminutes' vs 'length'.",
          "resolution": "Unified as 'runtime_minutes' in 'work' with integer type (SI unit)."
        },
        {
          "source_references": [
            "imdb.title_basics.genres",
            "sakila.category.name"
          ],
          "description": "Genre representation: string array vs normalized table.",
          "resolution": "Created 'genre' and 'work_genre' tables to normalize both."
        },
        {
          "source_references": [
            "imdb.title_akas.language",
            "sakila.language.name"
          ],
          "description": "Language: field in title_akas vs separate table.",
          "resolution": "Unified into 'language' table with 'name' from both sources."
        }
      ]
    },
    {
      "conflict_type": "Type",
      "conflicts": [
        {
          "source_references": [
            "imdb.name_basics.nconst",
            "imdb.title_basics.tconst"
          ],
          "description": "IMDb defines nconst/tconst as 'number' but they are alphanumeric strings.",
          "resolution": "Changed to string type in target."
        },
        {
          "source_references": [
            "imdb.title_basics.primarytitle"
          ],
          "description": "IMDb's primarytitle is typed as integer but is string.",
          "resolution": "Corrected to string type."
        },
        {
          "source_references": [
            "imdb.title_basics.startyear",
            "imdb.title_basics.endyear",
            "imdb.name_basics.birthyear",
            "imdb.name_basics.deathyear",
            "sakila.film.release_year"
          ],
          "description": "Year fields stored as strings but represent integers.",
          "resolution": "Converted to integer type."
        },
        {
          "source_references": [
            "sakila.film.length",
            "sakila.payment.amount",
            "sakila.film.rental_rate",
            "sakila.film.replacement_cost"
          ],
          "description": "Numeric values stored as strings in Sakila.",
          "resolution": "Converted to number/integer types."
        },
        {
          "source_references": [
            "imdb.name_basics.knownfortitles",
            "imdb.name_basics.primaryprofession",
            "imdb.title_basics.genres",
            "imdb.title_akas.types",
            "imdb.title_akas.attributes",
            "imdb.title_crew.directors",
            "imdb.title_crew.writers"
          ],
          "description": "IMDb stores multi-valued data in single columns as arrays/strings.",
          "resolution": "Normalized into dedicated tables (person_known_for_work, person_profession, etc.)."
        }
      ]
    },
    {
      "conflict_type": "Data Semantic",
      "conflicts": [
        {
          "source_references": [
            "imdb.title_basics.genres",
            "sakila.category.name"
          ],
          "description": "IMDb free-form genres vs Sakila controlled vocabulary, but values overlap.",
          "resolution": "Mapped to unified 'genre' table."
        },
        {
          "source_references": [
            "imdb.title_akas.language",
            "sakila.language.name"
          ],
          "description": "Language names from both schemas represent the same semantic concept.",
          "resolution": "Unified in 'language' table."
        }
      ]
    },
    {
      "conflict_type": "Structure",
      "conflicts": [
        {
          "source_references": [
            "imdb.name_basics",
            "sakila.actor",
            "sakila.staff",
            "sakila.customer"
          ],
          "description": "IMDb: single person table vs Sakila: separate tables for actors/staff/customers.",
          "resolution": "Unified into 'person' table with 'person_type' discriminator."
        },
        {
          "source_references": [
            "imdb.title_basics",
            "sakila.film"
